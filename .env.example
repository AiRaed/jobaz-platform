# ========= JobAZ AI — Local Ollama (optional) =========
# Pull a model first: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# OLLAMA_MODEL=mistral
# OLLAMA_MODEL=deepseek
# OLLAMA_MODEL_QUALITY=llama3
# Local CPU llama3 career JSON can take 1–3 minutes — use 180000 for JAZ.
# OLLAMA_TIMEOUT_MS=180000
# JAZ_OLLAMA_TIMEOUT_MS=180000

# AI_PROVIDER=ollama
# AI_PROVIDER_FALLBACK=true
# AI_PROVIDER_TIMEOUT_MS=60000

# OpenAI (production-quality features: CV, cover letter, interview, JSON)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_QUALITY=gpt-4o

# Debug Ollama route in production (default: dev only)
# ALLOW_OLLAMA_DEBUG=true

# ========= Career Knowledge Engine — Work in My Education v1 =========
# Production: leave unset or false (legacy conversation).
# Local/dev: defaults ON when unset (NODE_ENV=development). Set true explicitly
# for clarity, or false to force legacy locally.
# CAREER_KNOWLEDGE_ENGINE_WORK_IN_EDUCATION_V1=true
# Optional twin (same meaning; useful if you need client visibility):
# NEXT_PUBLIC_CAREER_KNOWLEDGE_ENGINE_WORK_IN_EDUCATION_V1=true
# Force classic flow even when ON: /career-engine/work-in-education?legacy=1
# Rollback: CAREER_KNOWLEDGE_ENGINE_WORK_IN_EDUCATION_V1=false
# Knowledge-engine Work in My Education: include draft library roles (default true).
# Set to false only after Career Library roles are approved for production.
WIE_PUBLIC_INCLUDE_DRAFTS=true
# WIE_RESULT_TOKEN_SECRET=

# ========= JobAZ application email (Resend) =========
# Server-only — never expose RESEND_API_KEY to the client.
# Does NOT replace Supabase Auth confirmation/reset emails.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=JobAZ <support@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://jobaz.co.uk
